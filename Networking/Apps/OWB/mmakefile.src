include $(SRCDIR)/config/aros-contrib.cfg

EXEDIR := $(AROS_CONTRIB)/Networking/Apps/OWB

USER_CFLAGS := -DZUNE_BUILTIN_SCROLLGROUP=0 -DWTF_PLATFORM_AROS=1
USER_INCLUDES := -I$(AROS_CONTRIB_INCLUDES)
USER_LDFLAGS := -L$(AROS_CONTRIB_LIB)

# The maketokenizer perl script has been patched to work with flex >= 2.5
BUILDOWB := yes

%build_prog mmake=contrib-networking-apps-startowb \
    files="startowb locale" targetdir=$(EXEDIR) \
    progname="startowb" uselibs="fontconfig xml2 freetype2.static z iconv pthread png lzma"

FILES :=               \
	tabs/tab           \
	tabs/tabs          \
	tabs/tabbedgroup   \
	main               \
	locale             \
	browsertab         \
	downloadmanager    \
	searchbar          \
	browserpreferences \
	preferencesmanager \
	tabbedview         \
	bookmarkmanager    \
	browserwindow      \
	browserapp

#MM- contrib-networking-apps: contrib-networking-apps-owb-$(BUILDOWB)
#MM- contrib-networking-apps-owb-yes : contrib-networking-apps-owb

#MM- contrib-networking-apps-startowb : contrib-fontconfig contrib-networking-apps-owb-catalogs

#MM- contrib-networking-apps-owb : workbench-libs-jpeg-linklib   \
#MM                        workbench-libs-png-linklib    \
#MM                        workbench-libs-thread         \
#MM                        workbench-libs-zstd-library-linklib \
#MM                        workbench-libs-lzma-library-linklib \
#MM                        contrib-zune-classes-webkitty         \
#MM                        contrib-networking-apps-owb-icon      \
#MM                        contrib-networking-apps-owb-catalogs  \
#MM                        contrib-networking-apps-owb-resources \
#MM                        contrib-networking-apps-owb-fonts     \
#MM                        contrib-networking-apps-owb-licenses  \
#MM                        contrib-networking-apps-startowb      \
#MM                        contrib-networking-apps-owb-quick

#MM contrib-networking-apps-owb-resources : contrib-networking-apps-owb-icons iconset-$(AROS_TARGET_ICONSET)-contrib-icons-owb contrib-networking-apps-owb-readme \
#MM     contrib-networking-apps-owb-icudata

I18N_LIBS=
# ifneq ($(AROS_TARGET_CPU),arm)
#    ifneq ($(AROS_TARGET_CPU),m68k)
#        ifneq ($(AROS_TARGET_CPU),ppc)
#            I18N_LIBS=icui18n icuuc icudata
#        endif
#    endif
# endif


#TODO: Link OWB with shared library version of freetype2

USER_CFLAGS := -DZUNE_BUILTIN_SCROLLGROUP=0 -DMUIMASTER_YES_INLINE_STDARG
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/tabs -I$(AROS_INCLUDES)/webkitty -I$(AROS_CONTRIB_INCLUDES)

# The engine is the webkitty Zune class (contrib/workbench/classes/mui/webkitty).
%build_prog mmake=contrib-networking-apps-owb progname=owb targetdir=$(EXEDIR) \
            files="$(FILES)" uselibs="webkitty codesets" alwayscxxlink=yes nix=yes

ICONS := back.png close.png download.png find.png forward.png go.png home.png preferences.png reload.png search.png stop.png bookmarks.png logo.png

%copy_files_q mmake=contrib-networking-apps-owb-icons files="$(ICONS)" src="icons" dst="$(EXEDIR)/resources"

%copy_files_q mmake=contrib-networking-apps-owb-readme files="README" dst="$(EXEDIR)/"

%copy_dir_recursive src="fonts" dst="$(EXEDIR)/fonts" mmake=contrib-networking-apps-owb-fonts
%copy_dir_recursive src="licenses" dst="$(EXEDIR)/licenses" mmake=contrib-networking-apps-owb-licenses

# ICU data files, read by the engine from PROGDIR:Resources
#MM- contrib-networking-apps-owb-icudata : contrib-icu4c
%copy_dir_recursive src="$(AROS_DEVELOPER)/share/icu/data" dst="$(EXEDIR)/resources" mmake=contrib-networking-apps-owb-icudata

%common
