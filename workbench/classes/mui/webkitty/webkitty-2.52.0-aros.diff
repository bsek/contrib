+        isprint(head[6]) ? head[6] : '.', isprint(head[7]) ? head[7] : '.', head[8], head[9], head[10], head[11]);
+    if (failures >= 3)
+        return;
+    failures++;
+    char name[64];
+    snprintf(name, sizeof(name), "RAM:ms-fail-%d-init.bin", failures);
+    dumpBuffer(name, init);
+    snprintf(name, sizeof(name), "RAM:ms-fail-%d-data.bin", failures);
+    dumpBuffer(name, &buffer);
+    dprintf("[MS] saved RAM:ms-fail-%d-*.bin\n", failures);
