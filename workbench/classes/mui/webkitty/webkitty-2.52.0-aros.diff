+#if OS(AROS)
+// AROS sends no memory pressure events: poll free RAM and shed caches, code
+// and the back/forward cache before allocations start failing.
+static void checkMemoryPressure()
+{
+	static MonotonicTime lastCheck, lastRelease;
+	auto now = MonotonicTime::now();
+	if (now - lastCheck < 2_s)
+		return;
+	lastCheck = now;
+
+	constexpr ULONG lowMemory = 96 * 1024 * 1024;
+	IPTR avail = AvailMem(MEMF_ANY);
+	if (avail >= lowMemory || now - lastRelease < 10_s)
+		return;
+	lastRelease = now;
+
+	dprintf("[WebProcess] low memory (%lu MB free), releasing caches\n", (unsigned long)(avail >> 20));
+	WebCore::releaseMemory(Critical::Yes, Synchronous::Yes);
+	dprintf("[WebProcess] %lu MB free after release\n", (unsigned long)(AvailMem(MEMF_ANY) >> 20));
+}
+#endif
+
 void WebProcess::handleSignals(const uint32_t /* sigmask */)
