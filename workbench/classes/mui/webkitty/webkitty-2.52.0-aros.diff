+// Scaled so that a forward then inverse FFT yields the original data.
+void FFTFrame::doInverseFFT(std::span<float> data)
 {
+    auto realData = m_realData.span();
+    auto imagData = m_imagData.span();
+    unsigned half = m_FFTSize / 2;
+    Vector<std::complex<float>> c(m_FFTSize);
