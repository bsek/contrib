+// In-place iterative radix-2 complex FFT; n is a power of two.
+void fftInPlace(Vector<std::complex<float>>& a, bool inverse)
+{
+    size_t n = a.size();
+    for (size_t i = 1, j = 0; i < n; i++) {
+        size_t bit = n >> 1;
+        for (; j & bit; bit >>= 1)
+            j ^= bit;
+        j ^= bit;
+        if (i < j)
+            std::swap(a[i], a[j]);
+    }
+    for (size_t len = 2; len <= n; len <<= 1) {
+        double angle = (inverse ? 2 : -2) * std::numbers::pi / len;
+        std::complex<double> step(cos(angle), sin(angle));
+        for (size_t i = 0; i < n; i += len) {
+            std::complex<double> w(1);
+            for (size_t k = 0; k < len / 2; k++) {
+                auto u = a[i + k];
+                auto v = a[i + k + len / 2] * std::complex<float>(w);
+                a[i + k] = u + v;
+                a[i + k + len / 2] = u - v;
+                w *= step;
+            }
+        }
+    }
+}
+
 } // anonymous namespace
 
