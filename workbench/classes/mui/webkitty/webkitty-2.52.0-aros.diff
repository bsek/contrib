+#pragma once
+
+// Force-included into WebKitLegacy on AROS (see PlatformMorphOS.cmake).
+//
+// The MorphOS sources use dprintf(const char *fmt, ...) for debug output and
+// declare it themselves, which clashes with POSIX dprintf(int fd, ...). Pull
+// in <stdio.h> first so its declaration is settled, then route every later
+// dprintf(...) - declarations and calls alike - to the serial debug printer.
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void wkAROSDebugPrintf(const char* format, ...);
+#ifdef __cplusplus
+}
+#endif
+
+#define dprintf(...) wkAROSDebugPrintf(__VA_ARGS__)
+
+// MorphOS <devices/newmouse.h> names for the NewMouse wheel rawkeys.
+#include <devices/rawkeycodes.h>
+#define NM_WHEEL_UP    RAWKEY_NM_WHEEL_UP
+#define NM_WHEEL_DOWN  RAWKEY_NM_WHEEL_DOWN
+#define NM_WHEEL_LEFT  RAWKEY_NM_WHEEL_LEFT
+#define NM_WHEEL_RIGHT RAWKEY_NM_WHEEL_RIGHT
