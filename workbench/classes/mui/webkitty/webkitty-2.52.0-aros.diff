+    return { String::fromUTF8(buffer.span().data()), AsyncFileHandle::adopt(fd) };
+}
+
+AsyncFileHandle openFileAsync(const String& path, FileOpenMode mode)
+{
+    CString fsRep = fileSystemRepresentation(path);
+    if (fsRep.isNull())
+        return { };
+
+    int flags = O_RDONLY;
+    if (mode == FileOpenMode::Truncate)
+        flags = O_WRONLY | O_CREAT | O_TRUNC;
+    else if (mode == FileOpenMode::ReadWrite)
+        flags = O_RDWR | O_CREAT;
+    int fd = open(fsRep.data(), flags, 0666);
+    if (fd < 0)
+        return { };
+    // MorphOS opens ReadWrite as MODE_APPEND: positioned at the end
+    if (mode == FileOpenMode::ReadWrite)
+        lseek(fd, 0, SEEK_END);
+    return AsyncFileHandle::adopt(fd);
+}
+
+AsyncFileHandle::AsyncFileHandle()
+    : m_handle(invalidPlatformFileHandle)
+{
