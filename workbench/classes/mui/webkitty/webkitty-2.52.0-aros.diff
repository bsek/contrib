+#if OS(AROS)
+void AcinerellaVideoDecoder::softwareBlitLocked()
+{
+	if (!m_decodedFrames.size())
+		return;
+	auto *avFrame = ac_get_frame_real(m_decodedFrames.first().frame());
+	if (!avFrame || !avFrame->data[0] || avFrame->width <= 0 || avFrame->height <= 0)
+		return;
+
+	int w = avFrame->width;
+	int h = avFrame->height;
+	if (!m_frameSurface || cairo_image_surface_get_width(m_frameSurface) != w || cairo_image_surface_get_height(m_frameSurface) != h) {
+		if (m_frameSurface)
+			cairo_surface_destroy(m_frameSurface);
+		m_frameSurface = cairo_image_surface_create(CAIRO_FORMAT_RGB24, w, h);
+	}
+	m_sws = sws_getCachedContext(m_sws, w, h, AVPixelFormat(avFrame->format), w, h, AV_PIX_FMT_BGRA, SWS_POINT, nullptr, nullptr, nullptr);
+	if (!m_sws || cairo_surface_status(m_frameSurface) != CAIRO_STATUS_SUCCESS)
+		return;
+
+	cairo_surface_flush(m_frameSurface);
+	uint8_t *dst[1] = { cairo_image_surface_get_data(m_frameSurface) };
+	int dstStride[1] = { cairo_image_surface_get_stride(m_frameSurface) };
+	sws_scale(m_sws, avFrame->data, avFrame->linesize, 0, h, dst, dstStride);
+	cairo_surface_mark_dirty(m_frameSurface);
+
+	// One repaint at a time; paint() takes the newest frame
+	if (!m_repaintPending.exchange(true) && m_client)
+		m_client->onDecoderWantsToRender(Ref{*this});
+}
