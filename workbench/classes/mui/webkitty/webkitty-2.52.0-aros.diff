+std::pair<String, AsyncFileHandle> openTemporaryFileAsync(StringView prefix)
+{
+    auto directory = tmpPathPrefixes.get(prefix.toString());
+    CString directoryUTF8 = directory.isEmpty() ? CString(temporaryFileDirectory()) : directory.utf8();
+    // no separator after a volume ("T:")
