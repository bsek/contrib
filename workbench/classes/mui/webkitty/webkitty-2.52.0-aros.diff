+#if OS(AROS)
+// AROS has no clipboard.library: use clipboard.device through iffparse with
+// IFF FTXT, whose CHRS text is in the system charset (ISO-8859-1).
+#define ARID_FTXT MAKE_ID('F','T','X','T')
+#define ARID_CHRS MAKE_ID('C','H','R','S')
+
+static String arosReadClipText(ULONG unit)
+{
+    Vector<char> text;
+    struct Library* IFFParseBase = OpenLibrary("iffparse.library", 39);
+    if (!IFFParseBase)
+        return { };
+    if (struct IFFHandle* iff = AllocIFF()) {
+        if ((iff->iff_Stream = (IPTR)OpenClipboard(unit))) {
+            InitIFFasClip(iff);
+            if (!OpenIFF(iff, IFFF_READ)) {
+                if (!StopChunk(iff, ARID_FTXT, ARID_CHRS)) {
+                    while (true) {
+                        LONG error = ParseIFF(iff, IFFPARSE_SCAN);
+                        if (error == IFFERR_EOC)
+                            continue;
+                        if (error)
+                            break;
+                        struct ContextNode* cn = CurrentChunk(iff);
+                        if (cn && cn->cn_Type == ARID_FTXT && cn->cn_ID == ARID_CHRS && cn->cn_Size > 0) {
+                            size_t offset = text.size();
+                            text.grow(offset + cn->cn_Size);
+                            if (ReadChunkBytes(iff, text.mutableSpan().subspan(offset).data(), cn->cn_Size) != LONG(cn->cn_Size))
+                                text.shrink(offset);
+                        }
+                    }
+                }
+                CloseIFF(iff);
+            }
+            CloseClipboard((struct ClipboardHandle*)iff->iff_Stream);
+        }
+        FreeIFF(iff);
+    }
+    CloseLibrary(IFFParseBase);
+    return String(std::span { reinterpret_cast<const Latin1Character*>(text.span().data()), text.size() });
+}
+
+static void arosWriteClipText(const String& text, ULONG unit)
+{
+    struct Library* IFFParseBase = OpenLibrary("iffparse.library", 39);
+    if (!IFFParseBase)
+        return;
+    CString bytes = text.latin1();
+    if (struct IFFHandle* iff = AllocIFF()) {
+        if ((iff->iff_Stream = (IPTR)OpenClipboard(unit))) {
+            InitIFFasClip(iff);
+            if (!OpenIFF(iff, IFFF_WRITE)) {
+                if (!PushChunk(iff, ARID_FTXT, ID_FORM, IFFSIZE_UNKNOWN)) {
+                    if (!PushChunk(iff, 0, ARID_CHRS, IFFSIZE_UNKNOWN)) {
+                        WriteChunkBytes(iff, (APTR)bytes.data(), bytes.length());
+                        PopChunk(iff);
+                    }
+                    PopChunk(iff);
+                }
+                CloseIFF(iff);
+            }
+            CloseClipboard((struct ClipboardHandle*)iff->iff_Stream);
+        }
+        FreeIFF(iff);
+    }
+    CloseLibrary(IFFParseBase);
+}
+#endif
